{% if site.email %}
  <a href="mailto:{{ site.email | encode_email }}" title="email" class="social-icon" style="margin-right: 15px;"><i class="fa-solid fa-envelope"></i></a>
{% endif %}
{% if site.telegram_username %}
  <a href="https://telegram.me/{{ site.telegram_username }}" title="telegram" class="social-icon" style="margin-right: 15px;"><i class="fa-brands fa-telegram"></i></a>
{% endif %}
{% if site.whatsapp_number %}
  <a href="https://wa.me/{{ site.whatsapp_number }}" title="whatsapp" class="social-icon" style="margin-right: 15px;"><i class="fa-brands fa-whatsapp"></i></a>
{% endif %}
{% if site.orcid_id %}
  <a href="https://orcid.org/{{ site.orcid_id }}" title="ORCID" class="social-icon" style="margin-right: 15px;"><i class="ai ai-orcid"></i></a>
{% endif %}
{% if site.scholar_userid %}
  <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" title="Google Scholar" class="social-icon" style="margin-right: 15px;"><i class="ai ai-google-scholar"></i></a>
{% endif %}
{% if site.alphaxiv_url %}
  <a href="{{ site.alphaxiv_url }}" title="alphaXiv" class="social-icon" style="margin-right: 15px;"><svg role="img" viewBox="0 0 718.41 504.47" xmlns="http://www.w3.org/2000/svg" height="1em" width="1.25em" fill="currentColor" aria-hidden="true"><polygon points="591.15 258.54 718.41 385.73 663.72 440.28 536.57 313.62 591.15 258.54"/><path d="M273.86.3c34.56-2.41 67.66 9.73 92.51 33.54l94.64 94.63-55.11 54.55-96.76-96.55c-16.02-12.7-37.67-12.2-53.19 1.11L54.62 288.82 0 234.23 204.76 29.57C223.12 13.31 249.27 2.02 273.86.3Z"/><path d="M663.79 1.29l54.62 54.58-418.11 417.9c-114.43 95.94-263.57-53.49-167.05-167.52l160.46-160.33 54.62 54.58-157.88 157.77c-33.17 40.32 18.93 91.41 58.66 57.48L663.79 1.29Z"/></svg></a>
{% endif %}
{% if site.semanticscholar_id %}
  <a href="https://www.semanticscholar.org/author/{{ site.semanticscholar_id }}" title="Semantic Scholar" class="social-icon" style="margin-right: 15px;"><i class="ai ai-semantic-scholar"></i></a>
{% endif %}
{% if site.publons_id %}
  <a href="https://publons.com/a/{{ site.publons_id }}/" title="Publons" class="social-icon" style="margin-right: 15px;"><i class="ai ai-publons"></i></a>
{% endif %}
{% if site.lattes_id %}
  <a href="http://lattes.cnpq.br/{{ site.lattes_id }}" target="_blank" title="Lattes" class="social-icon" style="margin-right: 15px;"><i class="ai ai-lattes"></i></a>
{% endif %}
{% if site.osf_id %}
  <a href="https://osf.io/{{ site.osf_id }}/" title="Open Science Framework" class="social-icon" style="margin-right: 15px;"><i class="ai ai-osf"></i></a>
{% endif %}
{% if site.research_gate_profile %}
  <a href="https://www.researchgate.net/profile/{{site.research_gate_profile}}/" title="ResearchGate" class="social-icon" style="margin-right: 15px;"><i class="ai ai-researchgate"></i></a>
{% endif %}
{% if site.ieee_id %}
  <a href="https://ieeexplore.ieee.org/author/{{site.ieee_id}}/" title="IEEE Xplore" class="social-icon" style="margin-right: 15px;"><i class="ai ai-ieee"></i></a>
{% endif %}
{% if site.acm_id %}
  <a href="https://dl.acm.org/profile/{{site.acm_id}}/" title="ACM DL" class="social-icon" style="margin-right: 15px;"><i class="ai ai-acm"></i></a>
{% endif %}
{% if site.scopus_id %}
  <a href="https://www.scopus.com/authid/detail.uri?authorId={{site.scopus_id}}" title="Scopus" class="social-icon" style="margin-right: 15px;"><i class="ai ai-scopus"></i></a>
{% endif %}
{% if site.github_username %}
  <a href="https://github.com/{{ site.github_username }}" title="GitHub" class="social-icon" style="margin-right: 15px;"><i class="fa-brands fa-github"></i></a>
{% endif %}
{% if site.linkedin_username %}
  <a href="https://www.linkedin.com/in/{{ site.linkedin_username }}" title="LinkedIn" class="social-icon" style="margin-right: 15px;"><i class="fa-brands fa-linkedin"></i></a>
{% endif %}
{% if site.x_username %}
  <a href="https://twitter.com/{{ site.x_username }}" title="X" class="social-icon" style="margin-right: 15px;"><i class="fa-brands fa-x-twitter"></i></a>
{% endif %}
