<div class="blog-post-card-horizontal blog-post-card mb-4" data-tags="{{ post_tags_for_data_attr }}" data-search="{{ post_search_text | strip | escape }}">
  <div class="post-date">{{ post.date | date: '%b %d, %Y' }}</div>
  <div class="blog-card-body{% if post.thumbnail %} blog-card-body-thumb{% endif %}">
    {% if post.tags.size > 0 %}
    <div class="post-tags-left">
      {% for tag in post.tags %}
      <a href="{{ '/blog/' | relative_url }}?tag={{ tag | slugify }}" class="tag-link" data-tag="{{ tag | slugify }}">
        {{ tag }}
      </a>
      {% endfor %}
    </div>
    {% endif %}
    <div class="post-middle-section">
      <h2 class="post-title-horizontal">
        {% if post.redirect == blank %}
          <a href="{{ post.url | relative_url }}">{{ post.title }}</a>
        {% elsif post.redirect contains '://' %}
          <a href="{{ post.redirect }}" target="_blank">{{ post.title }}</a>
        {% else %}
          <a href="{{ post.redirect | relative_url }}">{{ post.title }}</a>
        {% endif %}
      </h2>
      <div class="post-read-time">{{ read_time }} min read</div>
      <p class="post-description">{{ post.description }}</p>
    </div>
    {% if post.thumbnail %}
    <div class="post-right-section">
      <img src="{{ post.thumbnail | relative_url }}" alt="{{ post.title | escape }} thumbnail" class="post-thumbnail">
    </div>
    {% endif %}
  </div>
</div>
