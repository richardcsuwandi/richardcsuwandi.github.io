<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
    {% if page.profile and page.profile.image %}
      {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
      <link rel="preload" as="image" href="{{ profile_image_path | relative_url | bust_file_cache }}" fetchpriority="high">
    {% endif %}
  </head>

  <!-- Body -->
  <body class="profile-page {% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Profile layout: sticky sidebar on the left, sections on the right -->
    <div class="wide-about-container profile-layout mt-5" role="main">
      <aside class="profile-sidebar" aria-label="Profile">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          <div class="profile-photo-wrap">
            {%
              include figure.liquid loading="eager" path=profile_image_path class="img-fluid profile-photo" sizes="(min-width: 992px) 240px, 220px"
              alt=site.title cache_bust=true
            %}
          </div>
        {% endif %}

        <div class="profile-id">
          <h1 class="profile-name">{{ site.first_name }} {{ site.middle_name }} {{ site.last_name }}</h1>
          <p class="profile-role">
            {{ page.profile.role }}
            {% if page.profile.affiliation %}<br>{{ page.profile.affiliation }}{% endif %}
          </p>
        </div>

        <div class="about-contact">
          <div class="profile-actions" role="group" aria-label="Contact and curriculum vitae">
            <a class="profile-action" href="mailto:{{ site.email }}">
              <svg class="profile-action-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg>
              <span>Email me</span>
              <svg class="profile-action-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </a>
            <a class="profile-action" href="{{ '/assets/pdf/CV_Richard_Cornelius_Suwandi.pdf' | relative_url }}" target="_blank" rel="noopener noreferrer" aria-label="View CV (PDF, opens in a new tab)">
              <svg class="profile-action-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6M8 13h8M8 17h6"/></svg>
              <span>View CV</span>
              <svg class="profile-action-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>
            </a>
          </div>
        </div>

        {% if page.social %}
          <div class="profile-social">{% include social.liquid hide_email=true %}</div>
        {% endif %}

        {% if page.profile.location %}
          <ul class="profile-meta">
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
              <span>{{ page.profile.location }}</span>
            </li>
          </ul>
        {% endif %}

        <nav class="profile-toc" aria-label="On this page">
          <a href="#about">About</a>
          {% if page.news and site.announcements.enabled %}<a href="#news">News</a>{% endif %}
          {% if page.selected_papers %}<a href="#research">Research</a>{% endif %}
          {% if site.data.opensource %}<a href="#projects">Projects</a>{% endif %}
          {% if site.latest_posts.enabled %}<a href="#writing">Writing</a>{% endif %}
        </nav>
      </aside>

      <article class="profile-main">
        <!-- About -->
        <section id="about" class="profile-section">
          <div class="profile-lead">{{ content }}</div>

          {% if page.background %}
            <h3 class="profile-subhead">Background</h3>
            <ul class="background-list">
              {% for item in page.background %}
                <li>
                  <span class="background-logo">
                    {% if item.logo %}<img src="{{ '/assets/img/logos/' | append: item.logo | relative_url }}" alt="" width="40" height="40" loading="lazy">{% endif %}
                  </span>
                  <div class="background-body">
                    <div class="background-head">
                      {% if item.url %}<a class="background-org" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.org }}</a>{% else %}<span class="background-org">{{ item.org }}</span>{% endif %}
                      <span class="background-role">{{ item.role }}</span>
                    </div>
                    <div class="background-what">{{ item.what }}</div>
                  </div>
                  <span class="background-when">{{ item.when }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          {% if page.questions %}
            <h3 class="profile-subhead">Questions I'm thinking about</h3>
            <div class="question-cards">
              {% for q in page.questions %}
                <div class="question-card">
                  {% if q.glyph == 'adapt' %}
                    <svg viewBox="0 0 44 22" aria-hidden="true"><path class="q-accent" d="M2 16 C10 4,18 4,22 11 S34 20,42 6"/><path class="q-faint q-dash" d="M2 16 C10 10,18 12,22 14 S34 14,42 12"/></svg>
                  {% elsif q.glyph == 'discover' %}
                    <svg viewBox="0 0 44 22" aria-hidden="true"><circle class="q-fill" cx="8" cy="11" r="4"/><circle class="q-accent" cx="24" cy="5" r="3.5"/><circle class="q-accent" cx="24" cy="17" r="3.5"/><circle class="q-faint" cx="38" cy="11" r="3.5"/><path class="q-faint" d="M12 9.5 20.5 6M12 12.5l8.5 3.5M27.5 6l7 3.5"/></svg>
                  {% else %}
                    <svg viewBox="0 0 44 22" aria-hidden="true"><rect class="q-bar" x="6" y="11" width="6" height="7" rx="1.5"/><rect class="q-bar" x="16" y="7" width="6" height="11" rx="1.5"/><rect class="q-bar" x="26" y="9" width="6" height="9" rx="1.5"/><rect class="q-fill" x="36" y="3" width="6" height="15" rx="1.5"/></svg>
                  {% endif %}
                  <p>{{ q.text }}</p>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if page.closing %}
            <p class="profile-closing">{{ page.closing | markdownify | remove: '<p>' | remove: '</p>' | strip }}</p>
          {% endif %}
        </section>

        <!-- News -->
        {% if page.news and site.announcements.enabled %}
          <section id="news" class="profile-section">
            <div class="section-head">
              <h2>News</h2>
              <a href="{{ '/news/' | relative_url }}">All news &rarr;</a>
            </div>
            <div class="news-highlights">
              {% assign news_items = site.news | reverse %}
              {% for item in news_items limit: page.news_limit %}
                <div class="news-highlight">
                  {% if item.tag %}<span class="news-highlight-tag">{{ item.tag }}</span>{% endif %}
                  <div class="news-highlight-body">
                    {% if item.inline %}
                      {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                    {% else %}
                      <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
                    {% endif %}
                  </div>
                  <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%b %-d, %Y' }}</time>
                </div>
              {% endfor %}
            </div>
          </section>
        {% endif %}

        <!-- Selected research (reuses the paper cards from bib.liquid) -->
        {% if page.selected_papers %}
          <section id="research" class="profile-section">
            <div class="section-head">
              <h2>Selected research</h2>
              <a href="{{ '/research/' | relative_url }}">All research &rarr;</a>
            </div>
            {% include selected_papers.liquid %}
          </section>
        {% endif %}

        <!-- Projects -->
        {% if site.data.opensource %}
          <section id="projects" class="profile-section">
            <div class="section-head">
              <h2>Projects</h2>
              <a href="https://github.com/{{ site.github_username }}" target="_blank" rel="noopener noreferrer">GitHub &rarr;</a>
            </div>
            <div class="opensource-grid">
              {% for item in site.data.opensource limit: page.projects_limit %}
                {% include opensource_repo.liquid item=item %}
              {% endfor %}
            </div>
          </section>
        {% endif %}

        <!-- Writing -->
        {% if site.latest_posts.enabled %}
          <section id="writing" class="profile-section">
            <div class="section-head">
              <h2>Writing</h2>
              <a href="{{ '/blog/' | relative_url }}">All posts &rarr;</a>
            </div>
            <div class="writing-list">
              {% for post in site.posts limit: page.posts_limit %}
                {% if post.redirect == blank %}{% assign post_href = post.url | relative_url %}{% elsif post.redirect contains '://' %}{% assign post_href = post.redirect %}{% else %}{% assign post_href = post.redirect | relative_url %}{% endif %}
                <a class="writing-item" href="{{ post_href }}">
                  <span class="writing-thumb">
                    {% if post.thumbnail %}<img src="{{ post.thumbnail | relative_url }}" alt="" loading="lazy">{% endif %}
                  </span>
                  <span class="writing-text">
                    <span class="writing-title">{{ post.title }}</span>
                    {% if post.description %}<span class="writing-desc">{{ post.description }}</span>{% endif %}
                  </span>
                  <time datetime="{{ post.date | date_to_xmlschema }}">{{ post.date | date: '%b %-d, %Y' }}</time>
                </a>
              {% endfor %}
            </div>
          </section>
        {% endif %}
      </article>
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- Native controls load before optional third-party scripts. -->
    <script src="{{ '/assets/js/navbar-scroll.js' | relative_url }}"></script>
    <script src="{{ '/assets/js/disclosures.js' | relative_url }}"></script>
    <script src="{{ '/assets/js/motion.js' | relative_url }}"></script>
    <script src="{{ '/assets/js/profile-toc.js' | relative_url }}" defer></script>

    <!-- JavaScripts -->
    {% include scripts/jquery.liquid %}
    {% include scripts/bootstrap.liquid %}
    {% include scripts/masonry.liquid %}
    {% include scripts/mermaid.liquid %}
    {% include scripts/diff2html.liquid %}
    {% include scripts/leaflet.liquid %}
    {% include scripts/chartjs.liquid %}
    {% include scripts/echarts.liquid %}
    {% include scripts/vega.liquid %}
    {% include scripts/tikzjax.liquid %}
    {% include scripts/typograms.liquid %}
    {% include scripts/misc.liquid %}
    {% include scripts/badges.liquid %}
    {% include scripts/mathjax.liquid %}
    {% include scripts/pseudocode.liquid %}
    {% include scripts/analytics.liquid %}
    {% include scripts/progressBar.liquid %}
    {% include scripts/wechatModal.liquid %}
    {% include scripts/imageLayouts.liquid %}
    {% include scripts/jekyll_tabs.liquid %}
    {% include scripts/back_to_top.liquid %}
    
    <!-- Custom scripts -->
    <script src="{{ '/assets/js/awards-expand.js' | relative_url }}"></script>
    <script src="{{ '/assets/js/discovery-separator.js' | relative_url }}"></script>
  </body>
</html>
