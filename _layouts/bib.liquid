<div class="blog-post-card-horizontal mb-4" id="{{ entry.key }}">
  <div class="row g-0 align-items-start">
    <!-- Left column: Date and Tags -->
    <div class="col-md-2 post-left-section">
      <div class="post-date">
        {% if entry.month %}
          {% assign month_names = "Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec" | split: "," %}
          {% assign month_index = entry.month | minus: 1 %}
          {{ month_names[month_index] }} {{ entry.year }}
        {% else %}
          {{ entry.year }}
        {% endif %}
      </div>
      <div class="post-tags-left">
        {% if entry.abstract %}
          <span class="tag-link" onclick="toggleAbstract('{{ entry.key }}')" style="cursor: pointer;">ABSTRACT</span>
        {% endif %}
        {% if entry.website %}
          <a href="{{ entry.website }}" target="_blank" class="tag-link">PAPER</a>
        {% endif %}
        {% if entry.slides %}
          <a href="{{ '/assets/pdf/' | append: entry.slides | relative_url }}" target="_blank" class="tag-link">SLIDES</a>
        {% endif %}
        {% if entry.poster %}
          <a href="{{ '/assets/pdf/' | append: entry.poster | relative_url }}" target="_blank" class="tag-link">POSTER</a>
        {% endif %}
        {% if entry.alphaxiv %}
          <a
            href="{{ entry.alphaxiv }}"
            target="_blank"
            rel="noopener noreferrer"
            class="alphaxiv-link-badge"
            aria-label="alphaXiv"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 718.41 504.47" aria-hidden="true" focusable="false">
              <polygon fill="currentColor" points="591.15 258.54 718.41 385.73 663.72 440.28 536.57 313.62 591.15 258.54"></polygon>
              <path fill="currentColor" d="M273.86.3c34.56-2.41,67.66 9.73,92.51 33.54l94.64 94.63-55.11 54.55-96.76-96.55c-16.02-12.7-37.67-12.1-53.19 1.11L54.62 288.82 0 234.23 204.76 29.57C223.12 13.31 249.27 2.02 273.86.3Z"></path>
              <path fill="currentColor" d="M663.79 1.29l54.62 54.58-418.11 417.9c-114.43 95.94-263.57-53.49-167.05-167.52l160.46-160.33 54.62 54.58-157.88 157.77c-33.17 40.32 18.93 91.41 58.66 57.48L663.79 1.29Z"></path>
            </svg>
            <span>View on alphaXiv</span>
          </a>
        {% endif %}
        {% if entry.code %}
          <a
            href="{{ entry.code }}"
            target="_blank"
            rel="noopener noreferrer"
            class="github-code-badge"
            aria-label="View code on GitHub"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M12 .297c-6.63 0-12 5.37-12 12 0 5.303 3.438 9.8 8.205 10.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
            </svg>
            <span>View code</span>
          </a>
        {% endif %}
        {% if entry.thread %}
          <a
            href="{{ entry.thread }}"
            target="_blank"
            rel="noopener noreferrer"
            class="x-thread-badge"
            aria-label="View thread on X"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
            </svg>
            <span>View thread</span>
          </a>
        {% endif %}
      </div>
    </div>
    
    <!-- Middle column: Title, Authors, Venue -->
    <div class="col-md-6 post-middle-section">
      <h2 class="post-title-horizontal publication-title">
        {% if entry.website %}
          <a href="{{ entry.website }}" target="_blank">{{ entry.title }}</a>
        {% else %}
          {{ entry.title }}
        {% endif %}
      </h2>
      <div class="publication-authors">
        {% assign author_array_size = entry.author_array | size %}
        {% assign author_array_limit = author_array_size %}
        {% if site.max_author_limit and author_array_size > site.max_author_limit %}
          {% assign author_array_limit = site.max_author_limit %}
        {% endif %}
        {%- assign more_authors = author_array_size | minus: author_array_limit -%}

        {%- for author in entry.author_array limit: author_array_limit -%}
          {% assign author_is_self = false %}
          {%- assign author_last_name = author.last | remove: '¶' | remove: '&' | remove: '*' | remove: '†' | remove: '^' -%}
          {% if site.scholar.last_name contains author_last_name %}
            {% if site.scholar.first_name contains author.first %}
              {% assign author_is_self = true %}
            {% endif %}
          {%- endif -%}
          
          {%- if author_is_self -%}
            <strong>{{ author.first }} {{ author.last }}</strong>{%- if forloop.length > 1 and forloop.last == false -%}, {% elsif forloop.last and more_authors > 0 -%}, {% endif %}
          {%- else -%}
            {{ author.first }} {{ author.last }}{%- if forloop.length > 1 and forloop.last == false -%}, {% elsif forloop.last and more_authors > 0 -%}, {% endif %}
          {% endif %}
        {% endfor %}
        
        {% if more_authors > 0 %}
          <span class="more-authors-toggle" style="color: #999; cursor: pointer;" 
                onclick="toggleMoreAuthors('{{ entry.key }}')">
            {{ more_authors }} more author{% if more_authors > 1 %}s{% endif %}
          </span>
          <span id="more-authors-{{ entry.key }}" style="display: none;">
            {%- for author in entry.author_array offset: author_array_limit -%}
              {% if forloop.first %}{% else %}, {% endif %}{{ author.first }} {{ author.last }}
            {%- endfor -%}
          </span>
        {% endif %}
      </div>
      <div class="publication-venue">
        {% assign presentation_kind = entry.presentation | default: '' | downcase | strip %}
        {% assign proceedings = 'inproceedings,incollection' | split: ',' %}
        {% assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' %}
        <div class="publication-venue-line">
          <span class="publication-venue-text">
            {% if presentation_kind == 'oral' %}
              <span class="presentation-badge presentation-badge-oral">ORAL</span>
            {% elsif presentation_kind == 'preprint' %}
              <span class="presentation-badge presentation-badge-preprint">PREPRINT</span>
            {% endif %}
            {% if entry.type == 'article' %}
              <em>{{ entry.journal }}</em>, {{ entry.year }}
            {% elsif proceedings contains entry.type %}
              <em>{{ entry.booktitle }}</em>, {{ entry.year }}
            {% elsif thesis contains entry.type %}
              <em>{{ entry.school }}</em>, {{ entry.year }}
            {% else %}
              {{ entry.year }}
            {% endif %}
          </span>
        </div>
      </div>
    </div>
    
    <!-- Right column: Preview Image -->
    <div class="col-md-4 post-right-section">
      {% if entry.preview %}
        {% if entry.preview contains '://' %}
          <img src="{{ entry.preview }}" alt="{{ entry.title | escape }} preview" class="paper-thumbnail">
        {% else %}
          <img src="{{ '/assets/img/publication_preview/' | append: entry.preview | relative_url }}" 
               alt="{{ entry.title | escape }} preview" class="paper-thumbnail">
        {% endif %}
      {% endif %}
    </div>
  </div>
  
  <!-- Abstract (hidden by default) -->
  {% if entry.abstract %}
    <div id="abstract-{{ entry.key }}" class="publication-abstract" style="display: none;">
      <div class="abstract-content">
        {% if entry.tldr %}
          <h5 class="abstract-heading">TL;DR</h5>
          <p class="publication-tldr">{{ entry.tldr }}</p>
        {% endif %}
        <h5 class="abstract-heading">Abstract</h5>
        <p>{{ entry.abstract }}</p>
      </div>
    </div>
  {% endif %}
</div>

<script>
function toggleAbstract(key) {
  var abstract = document.getElementById('abstract-' + key);
  if (abstract.style.display === 'none' || abstract.style.display === '') {
    abstract.style.display = 'block';
  } else {
    abstract.style.display = 'none';
  }
}

function toggleMoreAuthors(key) {
  var moreAuthors = document.getElementById('more-authors-' + key);
  var toggle = document.querySelector('[onclick="toggleMoreAuthors(\'' + key + '\')"]');
  
  if (moreAuthors.style.display === 'none') {
    moreAuthors.style.display = 'inline';
    toggle.style.display = 'none';
  }
}
</script> 