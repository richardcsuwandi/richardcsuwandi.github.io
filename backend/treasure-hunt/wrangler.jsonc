{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "richard-treasure-hunt",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SITE_ORIGIN": "https://richardcsuwandi.github.io",
    "SITE_PATH": "/agents/",
    "ADDITIONAL_ORIGINS": "http://localhost:4000,http://127.0.0.1:4000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "richard-treasure-hunt",
      "database_id": "2eb36610-25bc-44d6-a595-59111a9cd3c5",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] }
}
